# Copy to backend/.env and fill in. backend/.env is gitignored and must stay that way —
# NF_MW_OUTH_KEY and NF_MW_JWT_SECRET are live CRM credentials.
#
#   node --env-file=backend/.env backend/dev.js
#
# With no .env at all the demo runs against the mock site on :4100 exactly as before, which is
# why none of these have defaults baked into the code.

# Where new clients go: adt_solution (the mock) | newforce_mw (the real CRM)
CLIENT_SOURCE=newforce_mw

# Staging. Production is https://mw.newforceltd.com — do not point a demo at it, every
# submission is a real lead and the middleware emails experts@adtsolution.com on success.
NF_MW_URL=https://nfmwstaging.maaserp.com
NF_MW_OUTH_KEY=
NF_MW_JWT_SECRET=

# 30s to match the PHP client: a successful lead takes ~1.4s because the middleware sends its
# notification email before answering.
NF_MW_TIMEOUT_MS=30000

# CRM user id recorded as the creator of these leads. 1 is the website default; set it to a
# dedicated service account once one exists.
NF_MW_CREATE_BY=1

# ---------------------------------------------------------------------------------------
# Bhaiyaa store sync (inbound). Unset these and the Store Operations board simply shows its
# seeded rows; the Sync button reports that the backend cannot reach Bhaiyaa.
# ---------------------------------------------------------------------------------------
BHAIYAA_MW_URL=https://bhaiyaastaging.maaserp.com/Dhihyperlocal_Seller_MW/v18
BHAIYAA_OUTH_KEY=
BHAIYAA_TIMEOUT_MS=15000
# How far back one poll looks. Also the most stores that can arrive between two polls without
# one being missed, since the list is id-descending and we cut it at the cursor.
BHAIYAA_PAGE_SIZE=25

# 0 makes the CRM reject a repeat email outright. Do not set this to 1 without reading
# NEWFORCE_MW_CLIENT_SYNC_PLAN.md §6.2 — with duplicates allowed the CRM returns an EXISTING
# user_id, and two clients pointing at one CRM record collide on our unique index.
NF_MW_ALLOW_DUPLICATE=0
